{
  "description": "Wire protocol between the aseprite-agent bridge and the Aseprite extension (JSON-RPC 2.0 over WebSocket). This file is the single definition: the extension ships it, the bridge copies it, and contract tests check both sides against it. Bump version on any incompatible change.",
  "version": 28,
  "handshake": {
    "hello": "extension -> bridge, first message: { token, protocol, asepriteVersion }",
    "welcome": "bridge -> extension: the connection is accepted",
    "incompatible": "bridge -> extension, then close: { expected, received, message }"
  },
  "requests": {
    "ping": {
      "kind": "read",
      "params": {}
    },
    "get_state": {
      "kind": "read",
      "params": {}
    },
    "get_context": {
      "kind": "read",
      "params": {}
    },
    "execute_lua": {
      "kind": "scoped-write",
      "needsSprite": false,
      "params": {
        "code": "string",
        "args": "any?",
        "label": "string?",
        "transaction": "boolean?"
      }
    },
    "snapshot": {
      "kind": "read",
      "needsSprite": true,
      "binary": true,
      "params": {
        "layer": "layer?",
        "frame": "frame?"
      }
    },
    "read_pixels": {
      "kind": "read",
      "needsSprite": true,
      "params": {
        "x": "integer?",
        "y": "integer?",
        "width": "integer?",
        "height": "integer?",
        "layer": "layer?",
        "frame": "frame?"
      }
    },
    "run_command": {
      "kind": "scoped-write",
      "needsSprite": false,
      "params": {
        "name": "string",
        "params": "object?"
      }
    },
    "undo": {
      "kind": "write",
      "needsSprite": false,
      "params": {
        "steps": "integer?"
      }
    },
    "redo": {
      "kind": "write",
      "needsSprite": false,
      "params": {
        "steps": "integer?"
      }
    },
    "check": {
      "kind": "read",
      "needsSprite": true,
      "params": {
        "layer": "layer?",
        "frames": "frames?all",
        "rules": "array?"
      }
    },
    "diff_visual": {
      "kind": "read",
      "binary": true,
      "params": {
        "checkpoint": "string?",
        "save": "string?",
        "scale": "integer?"
      }
    },
    "propose_variations": {
      "kind": "read",
      "params": {
        "task": "string"
      }
    },
    "compile_lua": {
      "kind": "read",
      "params": {
        "code": "string"
      }
    },
    "commands_changed": {
      "kind": "read",
      "params": {
        "dir": "string?"
      }
    },
    "get_timeline_text": {
      "kind": "read",
      "needsSprite": true,
      "params": {}
    },
    "apply_timeline_text": {
      "kind": "scoped-write",
      "params": {
        "text": "string",
        "plan": "boolean?"
      }
    },
    "state_block": {
      "kind": "read",
      "params": {}
    },
    "collect_colors": {
      "kind": "read",
      "needsSprite": true,
      "params": {
        "layer": "layer?",
        "frames": "frames?all",
        "hidden": "boolean?",
        "selection": "boolean?"
      }
    },
    "get_palette": {
      "kind": "read",
      "needsSprite": true,
      "params": {}
    },
    "set_palette": {
      "kind": "write",
      "params": {
        "colors": "array",
        "append": "boolean?",
        "label": "string?"
      }
    },
    "apply_color_map": {
      "kind": "write",
      "params": {
        "map": "object",
        "layer": "layer?",
        "frames": "frames?all",
        "label": "string?"
      }
    },
    "draw_swatches": {
      "kind": "scoped-write",
      "params": {
        "colors": "array",
        "name": "string?",
        "prompt": "string?",
        "size": "integer?"
      }
    },
    "create_sprite": {
      "kind": "write",
      "needsSprite": false,
      "params": {
        "width": "integer",
        "height": "integer",
        "rgba": "string",
        "title": "string?",
        "palette": "array?"
      }
    },
    "create_animation": {
      "kind": "write",
      "needsSprite": false,
      "params": {
        "width": "integer",
        "height": "integer",
        "frames": "array",
        "title": "string?",
        "palette": "array?",
        "tags": "array?"
      }
    },
    "split_layer_by_colors": {
      "kind": "scoped-write",
      "params": {
        "layer": "layer?",
        "groups": "array"
      }
    },
    "put_image": {
      "kind": "scoped-write",
      "params": {
        "width": "integer",
        "height": "integer",
        "rgba": "string",
        "frame": "frame?",
        "layer": "layer?",
        "new_layer": "string?",
        "above": "layer?",
        "hide_source": "boolean?",
        "hide": "boolean?",
        "x": "integer?",
        "y": "integer?",
        "label": "string?",
        "prompt": "string?",
        "blend_mode": "string?",
        "opacity": "integer?"
      }
    },
    "put_images": {
      "kind": "scoped-write",
      "params": {
        "images": "array",
        "frames": "integer?",
        "duration": "integer?",
        "label": "string?",
        "prompt": "string?",
        "palette": "array?"
      }
    },
    "mirror_frames": {
      "kind": "scoped-write",
      "params": {
        "tag": "string?",
        "frames": "frames?",
        "new_tag": "string?",
        "keep_layers": "array?"
      }
    },
    "set_slice": {
      "kind": "write",
      "params": {
        "name": "string",
        "x": "integer",
        "y": "integer",
        "w": "integer",
        "h": "integer",
        "center": "object?"
      }
    },
    "create_tilemap": {
      "kind": "write",
      "needsSprite": false,
      "params": {
        "tile": "integer",
        "width": "integer",
        "height": "integer",
        "rgba": "string",
        "columns": "integer",
        "count": "integer",
        "map": "array",
        "title": "string?"
      }
    },
    "render_text": {
      "kind": "read",
      "binary": true,
      "params": {
        "text": "string",
        "font": "string",
        "size": "number?"
      }
    },
    "save_palette": {
      "kind": "read",
      "params": {
        "colors": "array",
        "path": "string"
      }
    }
  },
  "kinds": {
    "read": "Leaves the document alone. Runs as is, also for a sub-agent.",
    "write": "Changes the document in a way the scope guard can't check (undo history, palette, slices, another sprite). Captured as an edit step; refused for a sub-agent's scope.",
    "scoped-write": "Changes cels, layers or frames of the active sprite. Captured as an edit step; for a sub-agent's scope, undone when it changed anything outside the scope.",
    "needsSprite": "Whether the request needs an active sprite (\"No active sprite\" otherwise). Default: true for writes, false for reads."
  },
  "params": {
    "types": "Each request lists its params as name: type. Types: string, integer, number, boolean, array, object, any, layer, frame, frames. A trailing ? marks it optional. Unknown params are an error, except scope (sub-agent scopes), which any request may carry.",
    "layer": "A layer id ('L12', or 12) or a layer name (searched through groups, top first). The extension resolves it to the layer's id before the handler runs; a missing layer is an error.",
    "frame": "A 1-based frame number in range. Omitted means the active frame; the extension fills it in.",
    "frames": "A frame spec: a number, a list of numbers, 'a-b' (inclusive), or 'all'. The extension resolves it to a list of frame numbers in range; out-of-range frames are an error. 'frames?all' defaults to every frame, 'frames?active' to the active frame, plain 'frames?' leaves it out.",
    "frameSpecExamples": [
      {
        "spec": 3,
        "count": 4,
        "active": 1,
        "frames": [
          3
        ]
      },
      {
        "spec": [
          1,
          3
        ],
        "count": 4,
        "active": 1,
        "frames": [
          1,
          3
        ]
      },
      {
        "spec": "2-4",
        "count": 5,
        "active": 1,
        "frames": [
          2,
          3,
          4
        ]
      },
      {
        "spec": "all",
        "count": 3,
        "active": 2,
        "frames": [
          1,
          2,
          3
        ]
      },
      {
        "spec": "5",
        "count": 5,
        "active": 1,
        "frames": [
          5
        ]
      },
      {
        "spec": null,
        "default": "active",
        "count": 4,
        "active": 2,
        "frames": [
          2
        ]
      },
      {
        "spec": null,
        "default": "all",
        "count": 3,
        "active": 2,
        "frames": [
          1,
          2,
          3
        ]
      },
      {
        "spec": 6,
        "count": 5,
        "active": 1,
        "error": "out of range"
      },
      {
        "spec": "3-9",
        "count": 5,
        "active": 1,
        "error": "out of range"
      },
      {
        "spec": "abc",
        "count": 5,
        "active": 1,
        "error": "Frames must be"
      }
    ]
  },
  "blendModes": "put_image and put_images take blend_mode for the layer they make (new_layer): normal, multiply, screen, overlay, darken, lighten, color_dodge, color_burn, hard_light, soft_light, difference, exclusion, hue, saturation, color, luminosity, addition, subtract or divide; get_state reports each image layer's blendMode by the same names. opacity is 0-255.",
  "putImages": "put_images writes several images in one undo step: images is a list of put_image params (width, height, rgba, frame (required), new_layer or layer, above (a layer id or name, also one made earlier in the same request), x, y, hide, blend_mode, opacity). frames: the sprite gets at least this many frames first; each new frame copies the cels of the last frame (as Aseprite's New Frame does) and lasts duration ms (default: the last frame's). palette: hex colors appended to the sprite palette before the images are written (the ones it lacks, compared as normalized hex), in the same undo step; the result counts them as paletteAdded.",
  "binaryResults": "A request marked binary answers with a result containing binary: true, followed by exactly one binary WebSocket frame with the data.",
  "bridgeMethods": [
    "chat.info",
    "chat.send",
    "chat.stop",
    "chat.reset",
    "chat.permission",
    "commands.history",
    "commands.revert",
    "commands.setEnabled",
    "dev.status",
    "dev.apply",
    "dev.build",
    "dev.discard",
    "dev.relaunch",
    "skills.list"
  ],
  "bridgeMethodIds": "Requests the extension sends use string ids, so they never collide with the bridge's numeric ids.",
  "notifications": {
    "chat.event": {
      "types": [
        "status",
        "text",
        "thinking",
        "tool",
        "tool_result",
        "done",
        "error",
        "session",
        "plan",
        "permission",
        "build"
      ],
      "fields": [
        "type",
        "text",
        "tool",
        "id",
        "kind",
        "detail",
        "ok",
        "provider",
        "sessionId",
        "name",
        "entries",
        "requestId",
        "options",
        "agent"
      ]
    }
  }
}
