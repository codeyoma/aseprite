{
  "scenarios": [
    {
      "name": "put_image sets a new layer's blend mode and opacity; other layers and bad values are refused before anything changes",
      "fixture": {
        "width": 2, "height": 1,
        "layers": [{ "name": "Body", "cels": { "1": ["r."] } }]
      },
      "steps": [
        { "state": { "layers": [{ "name": "Body", "blendMode": "normal", "opacity": 255 }] } },
        { "request": "put_image", "params": { "new_layer": "glow", "width": 2, "height": 1, "rgba": { "rows": ["b."] }, "blend_mode": "addition", "opacity": 128 },
          "result": { "name": "AI: glow", "layer": { "$layerId": "AI: glow" } } },
        { "state": { "activeLayer": "AI: glow", "layers": [
          { "name": "AI: glow", "cels": [1], "blendMode": "addition", "opacity": 128 },
          { "name": "Body", "cels": [1], "blendMode": "normal", "opacity": 255 }
        ] } },
        { "pixels": { "layer": "AI: glow" }, "rows": ["b."] },
        { "request": "put_image", "params": { "layer": "Body", "width": 2, "height": 1, "rgba": { "rows": ["g."] }, "blend_mode": "screen" },
          "error": "blend_mode and opacity apply to a new layer (new_layer)" },
        { "request": "put_image", "params": { "new_layer": "x", "width": 2, "height": 1, "rgba": { "rows": ["g."] }, "blend_mode": "glowy" },
          "error": "Unknown blend mode: glowy" },
        { "request": "put_image", "params": { "new_layer": "x", "width": 2, "height": 1, "rgba": { "rows": ["g."] }, "opacity": 300 },
          "error": "opacity must be an integer from 0 to 255" },
        { "state": { "layers": [{ "name": "AI: glow" }, { "name": "Body", "cels": [1] }] } },
        { "pixels": { "layer": "Body" }, "rows": ["r."] }
      ]
    },
    {
      "name": "put_images adds frames (copies of the last one) and writes every image, a layer above one made in the same request",
      "notes": "One undo step in Aseprite (one transaction). New frames copy the last frame's cels and take duration; the active layer ends on the last layer made.",
      "fixture": {
        "width": 2, "height": 1, "durations": [100, 200],
        "tags": [{ "name": "idle", "from": 1, "to": 2 }],
        "layers": [{ "name": "Body", "cels": { "1": ["r."], "2": [".r"] } }]
      },
      "steps": [
        { "request": "put_images", "params": { "frames": 4, "duration": 50, "label": "Add FX", "images": [
          { "new_layer": "fx", "frame": 2, "width": 1, "height": 1, "x": 0, "y": 0, "rgba": { "rows": ["y"] } },
          { "new_layer": "fx", "frame": 4, "width": 1, "height": 1, "x": 1, "y": 0, "rgba": { "rows": ["y"] } },
          { "new_layer": "fx glow", "above": "AI: fx", "frame": 4, "width": 2, "height": 1, "rgba": { "rows": ["bb"] }, "blend_mode": "addition" }
        ] }, "result": {
          "layers": [{ "name": "AI: fx", "layer": { "$layerId": "AI: fx" } }, { "name": "AI: fx glow", "layer": { "$layerId": "AI: fx glow" } }],
          "frames": 4, "added": 2
        } },
        { "state": {
          "durations": [100, 200, 50, 50], "activeFrame": 1, "tags": [{ "name": "idle", "from": 1, "to": 2 }], "activeLayer": "AI: fx glow",
          "layers": [
            { "name": "AI: fx glow", "cels": [4], "blendMode": "addition", "opacity": 255 },
            { "name": "AI: fx", "cels": [2, 4], "blendMode": "normal" },
            { "name": "Body", "cels": [1, 2, 3, 4] }
          ]
        } },
        { "pixels": { "layer": "Body", "frame": 3 }, "rows": [".r"] },
        { "pixels": { "layer": "Body", "frame": 4 }, "rows": [".r"] },
        { "pixels": { "layer": "AI: fx", "frame": 2 }, "rows": ["y."] },
        { "pixels": { "layer": "AI: fx", "frame": 4 }, "rows": [".y"] },
        { "pixels": { "layer": "AI: fx glow", "frame": 4 }, "rows": ["bb"] },
        { "request": "put_images", "params": { "images": [] }, "error": "No images" },
        { "request": "put_images", "params": { "images": [{ "new_layer": "z", "frame": 9, "width": 1, "height": 1, "rgba": { "rows": ["y"] } }] },
          "error": "Image 1: frame 9 is out of range (1-4)" },
        { "request": "put_images", "params": { "images": [{ "new_layer": "z", "frame": 1, "width": 2, "height": 1, "rgba": { "rows": ["y"] } }] },
          "error": "Image 1: expected 8 bytes, got 4" },
        { "request": "put_images", "params": { "images": [{ "new_layer": "z", "width": 1, "height": 1, "rgba": { "rows": ["y"] } }] },
          "error": "Image 1: frame is required" },
        { "request": "put_images", "params": { "images": [{ "new_layer": "z", "frame": 1, "width": 1, "height": 1, "rgba": { "rows": ["y"] }, "tint": 1 }] },
          "error": "Image 1: unknown param 'tint'" },
        { "request": "put_images", "params": { "frames": 6, "images": [
          { "new_layer": "z", "frame": 1, "width": 1, "height": 1, "rgba": { "rows": ["y"] } },
          { "new_layer": "z", "frame": 6, "width": 1, "height": 1, "rgba": { "rows": ["y"] }, "blend_mode": "nope" }
        ] }, "error": "Image 2: Unknown blend mode: nope" },
        { "state": { "durations": [100, 200, 50, 50], "layers": [{ "name": "AI: fx glow" }, { "name": "AI: fx" }, { "name": "Body" }] } },
        { "request": "put_images", "params": { "frames": 2, "images": [{ "layer": "Body", "frame": 1, "width": 2, "height": 1, "rgba": { "rows": ["gg"] } }] },
          "result": { "frames": 4, "added": 0, "layers": [{ "name": "Body" }] } },
        { "pixels": { "layer": "Body", "frame": 1 }, "rows": ["gg"] }
      ]
    },
    {
      "name": "put_images appends the palette colors it lacks (compared as normalized hex) before writing, in the same request",
      "notes": "One undo step in Aseprite: the palette change and the images are one transaction. In an indexed sprite the new entries come first, so the image maps onto them exactly. A bad color fails before anything changes.",
      "fixture": {
        "width": 2, "height": 1, "colorMode": "indexed", "palette": ["#000000", "#ff0000"],
        "layers": [{ "name": "Body", "cels": { "1": ["r."] } }]
      },
      "steps": [
        { "request": "put_images", "params": { "palette": ["#FF0000", "#ffff00", "#00ff00", "#ffff00"], "images": [
          { "new_layer": "fx", "frame": 1, "width": 2, "height": 1, "rgba": { "rows": ["yg"] } }
        ] }, "result": { "frames": 1, "added": 0, "paletteAdded": 2, "layers": [{ "name": "AI: fx" }] } },
        { "state": { "colorMode": "indexed", "palette": ["#000000", "#ff0000", "#ffff00", "#00ff00"] } },
        { "pixels": { "layer": "AI: fx" }, "rows": ["yg"] },
        { "request": "put_images", "params": { "palette": ["#00ff00"], "images": [
          { "new_layer": "fx2", "frame": 1, "width": 1, "height": 1, "rgba": { "rows": ["g"] } }
        ] }, "result": { "paletteAdded": 0 } },
        { "request": "put_images", "params": { "palette": ["#0000ff", "nope"], "images": [
          { "new_layer": "z", "frame": 1, "width": 1, "height": 1, "rgba": { "rows": ["b"] } }
        ] }, "error": "Invalid color: nope" },
        { "state": { "palette": ["#000000", "#ff0000", "#ffff00", "#00ff00"], "layers": [{ "name": "AI: fx2" }, { "name": "AI: fx" }, { "name": "Body" }] } }
      ]
    },
    {
      "name": "put_images inserts frames with linked cels (or moved copies), grows tags, sets durations and records a hit",
      "notes": "One undo step in Aseprite. Inserts are numbered as before any insert; durations, hit and image frames after them. A tag covering `after` grows, a later one moves, and so do recorded hits. Writing into one frame of linked cels replaces only that frame's cel.",
      "fixture": {
        "width": 3, "height": 1, "durations": [100, 100, 100],
        "tags": [{ "name": "a", "from": 1, "to": 2 }, { "name": "b", "from": 3, "to": 3 }],
        "layers": [
          { "name": "Shadow", "cels": { "1": ["k.."] } },
          { "name": "Body", "cels": { "1": ["r.."], "2": [".r."], "3": ["..r"] } }
        ],
        "activeLayer": "Body"
      },
      "steps": [
        { "request": "put_images", "params": {
          "insert": [
            { "after": 2, "durations": [30, 40], "shift": { "layers": ["Body"], "offsets": [{ "x": 1, "y": 0 }, { "x": 0, "y": 0 }] } },
            { "after": 1, "durations": [50] }
          ],
          "durations": [{ "frame": 1, "ms": 60 }],
          "hit": { "frame": 4, "freeze_ms": 120, "shake_ms": 70, "amp": 1 },
          "images": [{ "new_layer": "fx", "frame": 2, "width": 1, "height": 1, "x": 1, "y": 0, "rgba": { "rows": ["y"] } }]
        }, "result": { "frames": 6, "added": 0, "inserted": 3, "layers": [{ "name": "AI: fx" }] } },
        { "state": {
          "durations": [60, 50, 100, 30, 40, 100], "activeFrame": 1,
          "tags": [{ "name": "a", "from": 1, "to": 5 }, { "name": "b", "from": 6, "to": 6 }],
          "hits": [{ "frame": 4, "freezeMs": 120, "shakeMs": 70, "amp": 1 }],
          "layers": [
            { "name": "Shadow", "cels": [1, 2], "links": [[1, 2]] },
            { "name": "AI: fx", "cels": [2], "links": [] },
            { "name": "Body", "cels": [1, 2, 3, 4, 5, 6], "links": [[1, 2]] }
          ]
        } },
        { "pixels": { "layer": "Body", "frame": 2 }, "rows": ["r.."] },
        { "pixels": { "layer": "Body", "frame": 4 }, "rows": ["..r"] },
        { "pixels": { "layer": "Body", "frame": 5 }, "rows": [".r."] },
        { "pixels": { "layer": "Body", "frame": 6 }, "rows": ["..r"] },
        { "pixels": { "layer": "Shadow", "frame": 2 }, "rows": ["k.."] },
        { "request": "put_images", "params": { "insert": [{ "after": 3, "durations": [10] }], "images": [] },
          "result": { "frames": 7, "inserted": 1, "layers": [] } },
        { "state": {
          "durations": [60, 50, 100, 10, 30, 40, 100],
          "tags": [{ "name": "a", "from": 1, "to": 6 }, { "name": "b", "from": 7, "to": 7 }],
          "hits": [{ "frame": 5, "freezeMs": 120, "shakeMs": 70, "amp": 1 }],
          "layers": [{ "name": "Shadow", "links": [[1, 2]] }, { "name": "AI: fx" }, { "name": "Body", "links": [[1, 2], [3, 4]] }]
        } },
        { "request": "put_images", "params": { "images": [{ "layer": "Body", "frame": 2, "width": 3, "height": 1, "rgba": { "rows": ["w.."] } }] },
          "result": { "frames": 7 } },
        { "pixels": { "layer": "Body", "frame": 1 }, "rows": ["r.."] },
        { "pixels": { "layer": "Body", "frame": 2 }, "rows": ["w.."] },
        { "state": { "layers": [{ "name": "Shadow" }, { "name": "AI: fx" }, { "name": "Body", "links": [[3, 4]] }] } },
        { "request": "put_images", "params": { "insert": [{ "after": 9, "durations": [10] }], "images": [] }, "error": "after must be a frame from 1 to 7" },
        { "request": "put_images", "params": { "insert": [{ "after": 1, "durations": [10] }, { "after": 1, "durations": [20] }], "images": [] }, "error": "frame 1 is listed twice" },
        { "request": "put_images", "params": { "insert": [{ "after": 1, "durations": [10, 10], "shift": { "layers": ["Body"], "offsets": [{ "x": 1, "y": 0 }] } }], "images": [] }, "error": "shift needs one offset per new frame" },
        { "request": "put_images", "params": { "insert": [{ "after": 1, "durations": [0] }], "images": [] }, "error": "durations must be whole ms of at least 1" },
        { "request": "put_images", "params": { "durations": [{ "frame": 8, "ms": 10 }], "images": [] }, "error": "Durations 1: frame 8 is out of range (1-7)" },
        { "request": "put_images", "params": { "hit": { "frame": 2, "freeze_ms": -1 }, "images": [] }, "error": "hit: freeze_ms must be whole ms, 0 or more" },
        { "state": { "durations": [60, 50, 100, 10, 30, 40, 100], "hits": [{ "frame": 5 }] } }
      ]
    },
    {
      "name": "put_images records an effect on a layer (fx), also one it made, and the sprite snapshot adds its Addition glow",
      "notes": "One undo step in Aseprite: the record is a layer property set in the same transaction. fx.layer names a layer made in the request ('AI: <new_layer>') or any layer by id or name. Bad fx params fail before anything changes.",
      "fixture": {
        "width": 3, "height": 1,
        "layers": [{ "name": "Body", "cels": { "1": ["rr."] } }]
      },
      "steps": [
        { "request": "put_images", "params": {
          "images": [
            { "new_layer": "fx spark", "frame": 1, "width": 3, "height": 1, "rgba": { "rows": ["..y"] } },
            { "new_layer": "fx spark glow", "above": "AI: fx spark", "frame": 1, "width": 3, "height": 1, "rgba": { "rows": [".b."] }, "blend_mode": "addition" }
          ],
          "fx": { "layer": "AI: fx spark", "id": "spark", "x": 2, "y": 0, "fps": 30, "loop": false, "windup_ms": 66 }
        }, "result": { "layers": [{ "name": "AI: fx spark" }, { "name": "AI: fx spark glow" }] } },
        { "state": { "layers": [
          { "name": "AI: fx spark glow", "blendMode": "addition", "fx": { "$absent": true } },
          { "name": "AI: fx spark", "fx": { "id": "spark", "x": 2, "y": 0, "fps": 30, "loop": false, "windupMs": 66 } },
          { "name": "Body", "fx": { "$absent": true } }
        ] } },
        { "pixels": {}, "rows": ["rmy"] },
        { "request": "put_images", "params": { "images": [], "fx": { "layer": { "$id": "Body" }, "id": "aura", "x": 1, "y": 1, "fps": 12.5, "loop": true, "windup_ms": 0 } },
          "result": { "layers": [] } },
        { "state": { "layers": [
          { "name": "AI: fx spark glow" },
          { "name": "AI: fx spark", "fx": { "id": "spark" } },
          { "name": "Body", "fx": { "id": "aura", "x": 1, "y": 1, "fps": 12.5, "loop": true, "windupMs": 0 } }
        ] } },
        { "request": "put_images", "params": { "images": [], "fx": { "layer": "Body", "id": "a", "x": 0, "y": 0, "fps": 30, "windup_ms": 0 } },
          "error": "fx: loop must be true or false" },
        { "request": "put_images", "params": { "images": [], "fx": { "id": "a", "x": 0, "y": 0, "fps": 30, "loop": true, "windup_ms": 0 } },
          "error": "fx: layer is required" },
        { "request": "put_images", "params": { "images": [], "fx": { "layer": "Body", "id": "a", "x": "1", "y": 0, "fps": 30, "loop": true, "windup_ms": 0 } },
          "error": "fx: x and y are whole pixels" },
        { "request": "put_images", "params": { "images": [], "fx": { "layer": "Body", "id": "a", "x": 0, "y": 0, "fps": 30, "loop": true, "windup_ms": 0, "z": 1 } },
          "error": "fx: unknown param 'z'" },
        { "state": { "layers": [{ "name": "AI: fx spark glow" }, { "name": "AI: fx spark", "fx": { "id": "spark" } }, { "name": "Body", "fx": { "id": "aura" } }] } }
      ]
    },
    {
      "name": "an effect record may carry a recipe's JSON and render settings as text (#72)",
      "notes": "recipe and render are stored and reported back as given; anything but text, or text past 16384 characters, fails before anything changes.",
      "fixture": {
        "width": 2, "height": 1,
        "layers": [{ "name": "Body", "cels": { "1": ["r."] } }]
      },
      "steps": [
        { "request": "put_images", "params": { "images": [], "fx": {
          "layer": "Body", "id": "recipe:blue-burst", "x": 1, "y": 0, "fps": 30, "loop": false, "windup_ms": 33,
          "recipe": "{\"name\":\"blue-burst\",\"duration\":0.5}", "render": "{\"flip\":true}" } },
          "result": { "layers": [] } },
        { "state": { "layers": [{ "name": "Body", "fx": {
          "id": "recipe:blue-burst", "x": 1, "y": 0, "fps": 30, "loop": false, "windupMs": 33,
          "recipe": "{\"name\":\"blue-burst\",\"duration\":0.5}", "render": "{\"flip\":true}" } }] } },
        { "request": "put_images", "params": { "images": [], "fx": { "layer": "Body", "id": "a", "x": 0, "y": 0, "fps": 30, "loop": true, "windup_ms": 0, "recipe": 5 } },
          "error": "fx: recipe must be text of at most 16384 characters" },
        { "request": "put_images", "params": { "images": [], "fx": { "layer": "Body", "id": "a", "x": 0, "y": 0, "fps": 30, "loop": true, "windup_ms": 0, "render": { "flip": true } } },
          "error": "fx: render must be text" },
        { "request": "create_animation", "params": {
          "width": 1, "height": 1, "frames": [{ "rgba": { "rows": ["y"] } }],
          "fx": { "id": "recipe:glow", "x": 0, "y": 0, "fps": 30, "loop": true, "windup_ms": 0, "recipe": "{\"name\":\"glow\"}" }
        }, "result": { "frames": 1 } },
        { "state": { "layers": [{ "name": "Layer 1", "fx": { "id": "recipe:glow", "recipe": "{\"name\":\"glow\"}", "render": { "$absent": true } } }] } }
      ]
    },
    {
      "name": "put_images locks a new layer after writing every frame, keeps the active layer, and stores a pixel spec (#79)",
      "notes": "One undo step in Aseprite. locked sets layer.isEditable = false at the end of the transaction, so every frame of the layer is written first; the layer that was active stays active, so later writes do not land on the locked reference. spec is stored in the sprite property aseprite-agent \"concept.spec\" and reported as pixelSpec; an empty spec removes it.",
      "fixture": {
        "width": 2, "height": 1, "durations": [100, 100],
        "layers": [{ "name": "Art", "cels": { "1": ["r."] } }]
      },
      "steps": [
        { "request": "put_images", "params": { "label": "Storyboard to frames", "spec": "{\"canvas\":[2,1]}", "images": [
          { "new_layer": "Reference", "frame": 1, "width": 2, "height": 1, "rgba": { "rows": ["g."] }, "hide": true, "locked": true },
          { "new_layer": "Reference", "frame": 2, "width": 2, "height": 1, "rgba": { "rows": [".g"] }, "hide": true, "locked": true }
        ] }, "result": { "layers": [{ "name": "AI: Reference", "layer": { "$layerId": "AI: Reference" } }], "frames": 2, "added": 0 } },
        { "state": { "activeLayer": "Art", "pixelSpec": "{\"canvas\":[2,1]}", "layers": [
          { "name": "AI: Reference", "visible": false, "editable": false, "cels": [1, 2] },
          { "name": "Art", "visible": true, "editable": true, "cels": [1] }
        ] } },
        { "pixels": { "layer": "AI: Reference", "frame": 1 }, "rows": ["g."] },
        { "pixels": { "layer": "AI: Reference", "frame": 2 }, "rows": [".g"] },
        { "request": "put_images", "params": { "images": [{ "layer": "Art", "frame": 1, "width": 1, "height": 1, "rgba": { "rows": ["b"] }, "locked": true }] },
          "error": "Image 1: locked applies to a new layer (new_layer)" },
        { "request": "put_images", "params": { "images": [{ "new_layer": "x", "frame": 1, "width": 1, "height": 1, "rgba": { "rows": ["b"] }, "locked": "yes" }] },
          "error": "Image 1: locked must be true or false" },
        { "state": { "pixelSpec": "{\"canvas\":[2,1]}", "layers": [{ "name": "AI: Reference" }, { "name": "Art" }] } },
        { "request": "put_images", "params": { "images": [], "spec": "" }, "result": { "layers": [] } },
        { "state": { "pixelSpec": { "$absent": true } } }
      ]
    },
    {
      "name": "the sprite snapshot blends an Addition layer at partial opacity as drawSprite does; create_animation records an effect",
      "legend": { "p": "#ff0080", "q": "#0000ff80" },
      "fixture": {
        "width": 2, "height": 1,
        "layers": [{ "name": "Body", "cels": { "1": ["r."] } }]
      },
      "steps": [
        { "request": "put_image", "params": { "new_layer": "glow", "width": 2, "height": 1, "rgba": { "rows": ["bb"] }, "blend_mode": "addition", "opacity": 128 },
          "result": { "name": "AI: glow" } },
        { "pixels": {}, "rows": ["pq"] },
        { "request": "create_animation", "params": {
          "width": 1, "height": 1, "frames": [{ "rgba": { "rows": ["y"] }, "duration": 33 }],
          "fx": { "id": "torch", "x": 0, "y": 1, "fps": 30, "loop": true, "windup_ms": 0 }
        }, "result": { "frames": 1 } },
        { "state": { "layers": [{ "name": "Layer 1", "fx": { "id": "torch", "x": 0, "y": 1, "fps": 30, "loop": true, "windupMs": 0 } }] } },
        { "request": "create_animation", "params": {
          "width": 1, "height": 1, "frames": [{ "rgba": { "rows": ["y"] } }], "fx": { "layer": "x", "id": "torch", "x": 0, "y": 1, "fps": 30, "loop": true, "windup_ms": 0 }
        }, "error": "fx: unknown param 'layer'" }
      ]
    },
    {"name": "put_images clears a layer's cels first (clear, #97) and rewrites it in the same request; an unknown layer is refused before anything changes", "notes": "fx_pipeline replaces its earlier run this way: the layer keeps its place and name, frames the new run leaves empty end empty.", "fixture": {"width": 2, "height": 1, "durations": [100, 100], "layers": [{"name": "AI: fx old", "cels": {"1": [".y"], "2": [".y"]}}, {"name": "Body", "cels": {"1": ["r."], "2": ["r."]}}]}, "steps": [{"request": "put_images", "params": {"clear": ["Nope"], "images": []}, "error": "clear: no image layer Nope"}, {"state": {"layers": [{"name": "AI: fx old", "cels": [1, 2]}, {"name": "Body", "cels": [1, 2]}]}}, {"request": "put_images", "params": {"clear": ["AI: fx old"], "images": [{"new_layer": "fx old", "frame": 2, "width": 1, "height": 1, "x": 0, "y": 0, "rgba": {"rows": ["b"]}}]}, "result": {"layers": [{"name": "AI: fx old", "layer": {"$layerId": "AI: fx old"}}], "frames": 2, "added": 0}}, {"state": {"layers": [{"name": "AI: fx old", "cels": [2]}, {"name": "Body", "cels": [1, 2]}]}}, {"pixels": {"layer": "AI: fx old", "frame": 2}, "rows": ["b."]}, {"request": "put_images", "params": {"clear": ["AI: fx old"], "images": []}, "result": {"layers": [], "frames": 2, "added": 0}}, {"state": {"layers": [{"name": "AI: fx old", "cels": []}, {"name": "Body", "cels": [1, 2]}]}}]}
  ]
}
