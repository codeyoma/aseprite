{
  "scenarios": [
    {
      "name": "mirror_frames by tag: new flipped frames at the end, a new tag, keep_layers copied as they are",
      "notes": "Existing tags keep their frames, the mirrored tag too (Aseprite would grow a tag that ends on the last frame over the new frames). The active frame stays.",
      "fixture": {
        "width": 3, "height": 1, "durations": [100, 200],
        "tags": [{ "name": "walk_E", "from": 1, "to": 2 }],
        "layers": [
          { "name": "Hand", "cels": { "1": ["r.."] } },
          { "name": "G", "group": true, "layers": [{ "name": "Body", "cels": { "1": ["gb."], "2": [".b."] } }] },
          { "name": "Shadow", "visible": false, "cels": { "2": ["..y"] } }
        ]
      },
      "steps": [
        { "request": "mirror_frames", "params": { "tag": "walk_E", "new_tag": "walk_W", "keep_layers": ["Hand", "Nope"] }, "result": { "from": 3, "to": 4, "frames": 2 } },
        { "state": {
          "durations": [100, 200, 100, 200], "activeFrame": 1,
          "tags": [{ "name": "walk_E", "from": 1, "to": 2 }, { "name": "walk_W", "from": 3, "to": 4, "direction": "forward" }],
          "layers": [
            { "name": "Hand", "cels": [1, 3] },
            { "name": "G", "layers": [{ "name": "Body", "cels": [1, 2, 3, 4] }] },
            { "name": "Shadow", "cels": [2, 4] }
          ]
        } },
        { "pixels": { "layer": "Hand", "frame": 3 }, "rows": ["r.."] },
        { "pixels": { "layer": "Body", "frame": 3 }, "rows": [".bg"] },
        { "pixels": { "layer": "Body", "frame": 4 }, "rows": [".b."] },
        { "pixels": { "layer": "Shadow", "frame": 4 }, "rows": ["y.."] },
        { "request": "mirror_frames", "params": { "tag": "nope" }, "error": "No tag named nope" }
      ]
    },
    {
      "name": "mirror_frames by frame spec; tags keep their frames, also those ending on the last frame",
      "fixture": {
        "width": 2, "height": 1, "durations": [100, 150], "activeFrame": 2,
        "tags": [{ "name": "all", "from": 1, "to": 2 }, { "name": "x", "from": 1, "to": 1 }],
        "layers": [{ "name": "Art", "cels": { "1": ["r."], "2": ["g."] } }]
      },
      "steps": [
        { "request": "mirror_frames", "params": { "frames": "2" }, "result": { "from": 3, "to": 3, "frames": 1 } },
        { "pixels": { "layer": "Art", "frame": 3 }, "rows": [".g"] },
        { "request": "mirror_frames", "params": {}, "result": { "from": 4, "to": 6, "frames": 3 } },
        { "state": { "durations": [100, 150, 150, 100, 150, 150], "activeFrame": 2, "tags": [{ "name": "all", "from": 1, "to": 2 }, { "name": "x", "from": 1, "to": 1 }] } },
        { "pixels": { "frame": 6 }, "rows": ["g."] },
        { "request": "mirror_frames", "params": { "frames": [7] }, "error": "Frame 7 is out of range (1-6)" }
      ]
    },
    {
      "name": "split_layer_by_colors: one layer per group above the source, the rest stays as '(rest)'",
      "fixture": {
        "width": 4, "height": 1, "durations": [100, 100],
        "layers": [
          { "name": "Top" },
          { "name": "Art", "cels": { "1": ["rgbk"], "2": ["rrh."] } },
          { "name": "Base" }
        ],
        "activeLayer": "Art"
      },
      "steps": [
        { "request": "split_layer_by_colors", "params": { "groups": [
          { "name": "Outline", "colors": ["#000000"] },
          { "name": "Red", "colors": ["#ff0000", "#00ff00"] },
          { "name": "Empty", "colors": ["#ffff00"] }
        ] }, "result": { "layers": ["Outline", "Red", "Empty"] } },
        { "state": { "activeLayer": "Empty", "layers": [
          { "name": "Top" },
          { "name": "Outline", "cels": [1] },
          { "name": "Red", "cels": [1, 2] },
          { "name": "Empty", "cels": [] },
          { "name": "Art (rest)", "cels": [1] },
          { "name": "Base" }
        ] } },
        { "pixels": { "layer": "Art (rest)" }, "rows": ["..b."] },
        { "pixels": { "layer": "Red" }, "rows": ["rg.."] },
        { "pixels": { "layer": "Red", "frame": 2 }, "rows": ["rrh."] },
        { "pixels": { "layer": "Outline" }, "rows": ["...k"] }
      ]
    },
    {
      "name": "split_layer_by_colors removes the source when nothing is left; groups are refused",
      "fixture": {
        "width": 4, "height": 1,
        "layers": [
          { "name": "G", "group": true, "layers": [{ "name": "Kid", "cels": { "1": ["r..."] } }] },
          { "name": "Art", "cels": { "1": ["rr.."] } },
          { "name": "Other" }
        ],
        "activeLayer": "Art"
      },
      "steps": [
        { "request": "split_layer_by_colors", "params": { "layer": "Art", "groups": [{ "name": "Red", "colors": ["#ff0000"] }] }, "result": { "layers": ["Red"] } },
        { "state": { "activeLayer": "Red", "layers": [
          { "name": "G", "layers": [{ "name": "Kid" }] }, { "name": "Red", "cels": [1] }, { "name": "Other" }
        ] } },
        { "request": "split_layer_by_colors", "params": { "layer": "G", "groups": [{ "name": "A", "colors": ["#ff0000"] }] }, "error": "Pick an image layer" },
        { "request": "split_layer_by_colors", "params": { "layer": "Kid", "groups": [{ "name": "K", "colors": ["#ff0000"] }] }, "result": { "layers": ["K"] } },
        { "state": { "layers": [{ "name": "G", "layers": [{ "name": "K", "cels": [1] }] }, { "name": "Red" }, { "name": "Other" }] } }
      ]
    },
    {
      "name": "set_slice adds slices (listed newest first), replacing one of the same name; every bound is required",
      "fixture": { "width": 4, "height": 4, "layers": [{ "name": "Art" }] },
      "steps": [
        { "state": { "slices": [] } },
        { "request": "set_slice", "params": { "name": "btn", "x": 0, "y": 0, "w": 4, "h": 2 }, "result": { "slices": 1 } },
        { "request": "set_slice", "params": { "name": "panel", "x": 1, "y": 1, "w": 3, "h": 3, "center": { "x": 1, "y": 1, "w": 1, "h": 1 } }, "result": { "slices": 2 } },
        { "request": "set_slice", "params": { "name": "btn", "x": 1, "y": 1, "w": 2, "h": 2 }, "result": { "slices": 2 } },
        { "state": { "slices": [
          { "name": "btn", "bounds": { "x": 1, "y": 1, "width": 2, "height": 2 }, "center": { "$absent": true } },
          { "name": "panel", "bounds": { "x": 1, "y": 1, "width": 3, "height": 3 }, "center": { "x": 1, "y": 1, "width": 1, "height": 1 } }
        ] } },
        { "request": "set_slice", "params": { "name": "x", "x": 0, "y": 0, "w": 1 }, "error": "set_slice: 'h' is required" }
      ]
    }
  ]
}
