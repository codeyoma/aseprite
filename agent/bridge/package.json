{
  "name": "aseprite-agent",
  "version": "0.4.0",
  "description": "MCP bridge that lets Claude Code or Codex control Aseprite, plus the in-app chat runner.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aseprite-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "guide",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-guide.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "aseprite",
    "mcp",
    "claude-code",
    "codex",
    "pixel-art",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeyoma/aseprite.git",
    "directory": "agent/bridge"
  },
  "homepage": "https://github.com/codeyoma/aseprite/tree/agent/agent",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "pngjs": "^7.0.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
